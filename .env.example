# --- GitHub ---
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=owner/repo
GITHUB_API_BASE_URL=https://api.github.com

# --- Embeddings ---
# "sentence-transformers" (better quality, downloads all-MiniLM-L6-v2 on first run)
# or "tfidf" (zero-download offline fallback, good for CI runners)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Duplicate detection ---
SIMILARITY_THRESHOLD=0.86
TOP_K=5
ISSUE_STATE_TO_INDEX=all
MAX_BODY_CHARS=2000

# --- Bot behavior ---
POST_COMMENT=true
ADD_LABEL=true
DUPLICATE_LABEL=possible-duplicate
DRY_RUN=false

# --- Storage ---
INDEX_DIR=data/processed

# --- Evaluation ---
EVAL_DATASET_PATH=data/eval/duplicate_pairs.json
RESULTS_DIR=data/eval/results
